  ],

  "demandRecords": {
    "_comment": "7 days of demand records created per ward (today + 6 historical days)",
    "daysSeeded": 7
  },

  "gammaValues": [0, 1, 2, 3, 4],

  "optimizationNotes": {
    "model": "Bertsimas-Sim Gamma-robust counterpart",
    "variables": {
      "D_i": "nominal demand for ward i",
      "U_i": "maximum demand deviation for ward i",
      "x_i": "beds allocated to ward i (decision variable)",
      "z_i": "uncertainty variable in [0,1] for ward i",
      "Gamma": "uncertainty budget — max number of wards that can simultaneously hit worst-case demand"
    },
    "constraint": "sum(z_i) <= Gamma",
    "worstCaseDemand": "D_i + z_i * U_i"
  }
}
