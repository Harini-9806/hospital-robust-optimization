    { "name": "Dr. Sarah Connor",  "email": "doctor@hospital.com",  "role": "doctor",      "password": "Doctor@1234"  },
    { "name": "Operations Manager","email": "manager@hospital.com", "role": "bed_manager", "password": "Manager@1234" }
  ],

  "samplePatients": [
    { "name": "Alice Johnson", "age": 45, "gender": "female", "condition": "Cardiac Arrest",      "priority": "critical", "ward": "ICU",       "los": 7,  "status": "admitted"   },
    { "name": "Bob Martinez",  "age": 62, "gender": "male",   "condition": "Post-CABG Recovery",  "priority": "high",     "ward": "ICU",       "los": 5,  "status": "admitted"   },
    { "name": "Emma Davis",    "age": 29, "gender": "female", "condition": "Appendectomy",         "priority": "medium",   "ward": "Surgical",  "los": 3,  "status": "admitted"   },
    { "name": "Mia Allen",     "age": 25, "gender": "female", "condition": "Trauma - MVA",         "priority": "critical", "ward": "Emergency", "los": 1,  "status": "admitted"   },
    { "name": "Quinn Baker",   "age": 30, "gender": "male",   "condition": "Elective Surgery",     "priority": "low",      "ward": "Surgical",  "los": 3,  "status": "waiting"    },
