    "General":   { "occupied": 52, "available": 20, "reserved": 6, "maintenance": 2 },
    "Surgical":  { "occupied": 30, "available": 14, "reserved": 5, "maintenance": 1 },
    "Emergency": { "occupied": 28, "available": 8,  "reserved": 3, "maintenance": 1 }
