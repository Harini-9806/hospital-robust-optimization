    { "name": "General",   "totalBeds": 80, "nominalDemand": 60, "maximumDeviation": 10 },
    { "name": "Surgical",  "totalBeds": 50, "nominalDemand": 35, "maximumDeviation": 8  },
    { "name": "Emergency", "totalBeds": 40, "nominalDemand": 40, "maximumDeviation": 12 }
  ],

